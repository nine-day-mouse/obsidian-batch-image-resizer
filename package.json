	"description": "Batch set or clear the display size of every image in the current note.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"image"
	],
	"license": "MIT",
	"author": "nine-day-mouse",
	"repository": {
		"type": "git",
		"url": "https://github.com/nine-day-mouse/obsidian-batch-image-resizer.git"
	},
	"devDependencies": {
		"@types/node": "^16.18.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.21.5",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.4.5"
	}
}
